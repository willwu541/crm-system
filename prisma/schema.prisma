// 钢格板业务管理系统 - 数据库模型
// 使用标准 PostgreSQL: postgresql://user:password@localhost:5432/dbname

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
}

enum OrderStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuoteStatus {
  PENDING
  PREFERRED
  SELECTED
}

enum MainStatus {
  OPPORTUNITY
  CONVERTED
  IN_PRODUCTION
  PENDING_SHIPMENT
  COMPLETED
  CANCELLED
}

enum IntentionLevel {
  HIGH
  MEDIUM
  LOW
}

enum ProductionMode {
  SELF
  OUTSOURCE
  MIXED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum Tenant {
  domestic
  export
}

enum CustomerStatus {
  ACTIVE
  DORMANT
  AWAKENING
  LOST
}

enum RecordingAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum CustomerQuoteStatus {
  DRAFT
  SENT
  NEGOTIATING
  WON
  LOST
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           UserRole @default(SALES)
  isActive       Boolean  @default(true) @map("is_active")
  tenant         Tenant   @default(domestic)
  tenantId       String?  @map("tenant_id")
  /**
   * 邮件签名（外贸业务员个人签名，用于模板变量 {{user.signature}}）
   */
  emailSignature String?  @map("email_signature") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders               Order[]
  customers            Customer[]              @relation("CustomerOwner")
  customersCreated     Customer[]              @relation("CustomerCreatedBy")
  customersClaimed     Customer[]              @relation("CustomerPoolClaimedBy")
  callRecordings       CallRecording[]
  leads                Lead[]                  @relation("LeadOwner")
  leadsCreated         Lead[]                  @relation("LeadCreatedBy")
  customerQuotesCreated CustomerQuote[]        @relation("CustomerQuoteCreatedBy")
  customerQuotesApproved CustomerQuote[]        @relation("CustomerQuoteApprovedBy")
  tasks                Task[]
  moments              Moment[]
  followUps            FollowUp[]             @relation("FollowUpCreatedBy")
  fileAttachments      FileAttachment[]
  orderPayments        OrderPayment[]             @relation("OrderPaymentRecorder")
  exportTenant         ExportTenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  exportLeads          ExportLead[]
  exportCustomers      ExportCustomer[]
  exportActivities     ExportActivity[]
  exportTasks          ExportTask[]
  exportDeletionLogs   ExportDeletionLog[]
  exportEmailTemplates ExportEmailTemplate[]

  @@map("users")
}

model Customer {
  id             String         @id @default(cuid())
  name           String
  contactName    String         @map("contact_name")
  contactPhone   String         @map("contact_phone")
  wechat         String?
  region         String?
  source         String?
  industry       String?
  status         CustomerStatus @default(ACTIVE)
  // 公海相关字段
  isDealLost     Boolean        @default(false) @map("is_deal_lost")
  dealLostReason String?        @map("deal_lost_reason")
  dealLostAt     DateTime?      @map("deal_lost_at")
  isInPool       Boolean        @default(false) @map("is_in_pool")
  poolClaimedById String?       @map("pool_claimed_by_id")
  poolClaimedAt  DateTime?      @map("pool_claimed_at")
  poolReleasedAt DateTime?      @map("pool_released_at")
  poolEnteredAt  DateTime?      @map("pool_entered_at")
  poolAutoDays   Int?           @map("pool_auto_days")
  // 跟进时间
  lastContactAt  DateTime?      @map("last_contact_at")
  lastFollowUpAt DateTime?      @map("last_follow_up_at")
  nextFollowUpAt DateTime?      @map("next_follow_up_at")
  lastWakeUpAt   DateTime?      @map("last_wake_up_at")
  wakeUpCount    Int            @default(0) @map("wake_up_count")
  tier           String         @default("NORMAL") // VIP / NORMAL / LOW
  remark         String?
  ownerId        String         @map("owner_id")
  createdById    String         @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  owner         User             @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy     User             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  poolClaimedBy User?            @relation("CustomerPoolClaimedBy", fields: [poolClaimedById], references: [id], onDelete: SetNull)
  orders        Order[]
  recordings    CallRecording[]
  leads         Lead[]
  quotes        CustomerQuote[]
  tasks         Task[]
  followUps     FollowUp[]

  @@index([ownerId])
  @@index([status])
  @@index([isInPool])
  @@index([lastContactAt])
  @@index([nextFollowUpAt])
  @@index([dealLostAt])
  @@map("customers")
}

model CallRecording {
  id                String                  @id @default(cuid())
  customerId        String                  @map("customer_id")
  orderId           String?                 @map("order_id")
  title             String?
  fileName          String                  @map("file_name")
  filePath          String                  @map("file_path")
  fileSize          Int                     @map("file_size")
  mimeType          String                  @map("mime_type")
  duration          Int?
  transcript        String?                 @db.Text
  summary           String?                 @db.Text
  customerIntent    String?                 @map("customer_intent")
  keyPoints         String[]                @map("key_points")
  suggestedFollowUp String?                 @map("suggested_follow_up") @db.Text
  sentiment         String?
  analysisStatus    RecordingAnalysisStatus @default(PENDING) @map("analysis_status")
  analysisError     String?                 @map("analysis_error")
  uploadedById      String                  @map("uploaded_by_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([orderId])
  @@index([analysisStatus])
  @@index([createdAt])
  @@map("call_recordings")
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactName  String   @map("contact_name")
  contactPhone String   @map("contact_phone")
  address      String?
  remark       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model Order {
  id                    String          @id @default(cuid())
  orderNo               String          @unique @map("order_no")
  customerId            String?         @map("customer_id")
  customerName          String          @map("customer_name")
  contactName           String          @map("contact_name")
  contactPhone          String          @map("contact_phone")
  projectName           String          @map("project_name")
  deliveryRegion        String          @map("delivery_region")
  quoteDeadline         DateTime?       @map("quote_deadline")
  remark                String?
  status                OrderStatus     @default(DRAFT)
  mainStatus            MainStatus?     @map("main_status")
  isQuoted              Boolean         @default(false) @map("is_quoted")
  intentionLevel        IntentionLevel? @map("intention_level")
  productionMode        ProductionMode? @map("production_mode")
  hasSelectedSupplier   Boolean         @default(false) @map("has_selected_supplier")
  selectedQuoteId       String?         @unique @map("selected_quote_id")
  finalPrice            Decimal?        @map("final_price") @db.Decimal(18, 4)
  isOrderedToSupplier   Boolean         @default(false) @map("is_ordered_to_supplier")
  customerPaymentStatus PaymentStatus?  @map("customer_payment_status")
  supplierPaymentStatus PaymentStatus?  @map("supplier_payment_status")
  paidAmount            Decimal         @default(0) @map("paid_amount") @db.Decimal(18, 4)
  totalAmount           Decimal?        @map("total_amount") @db.Decimal(18, 4)
  createdById           String          @map("created_by_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  attachments   OrderAttachment[]
  quoteLinks    QuoteLink[]
  quotes        Quote[]
  recordings    CallRecording[]
  payments      OrderPayment[]
  selectedQuote Quote?            @relation("SelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  customerQuote CustomerQuote?

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String   @map("order_id")
  sortOrder          Int      @default(0) @map("sort_order")
  productType        String   @map("product_type")
  specModel          String   @map("spec_model")
  dimensions         String?
  quantity           Decimal  @db.Decimal(18, 4)
  unit               String
  surfaceTreatment   String?  @map("surface_treatment")
  specialRequirement String?  @map("special_requirement")
  remark             String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attachments OrderAttachment[]
  quoteItems  QuoteItem[]

  @@map("order_items")
}

/// 订单回款记录
model OrderPayment {
  id            String   @id @default(cuid())
  orderId       String   @map("order_id")
  amount        Decimal  @db.Decimal(18, 4)
  paymentDate   DateTime @map("payment_date")
  method        String   @default("BANK") // BANK / CASH / WECHAT / ALIPAY / OTHER
  remark        String?
  recordedById  String   @map("recorded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User  @relation("OrderPaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paymentDate])
  @@map("order_payments")
}

model OrderAttachment {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  orderItemId String?  @map("order_item_id")
  fileName    String   @map("file_name")
  filePath    String   @map("file_path")
  fileSize    Int      @map("file_size")
  mimeType    String   @map("mime_type")
  createdAt   DateTime @default(now()) @map("created_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_attachments")
}

model QuoteLink {
  id           String    @id @default(cuid())
  orderId      String    @map("order_id")
  token        String    @unique
  supplierName String?   @map("supplier_name")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@map("quote_links")
}

model Quote {
  id               String      @id @default(cuid())
  orderId          String      @map("order_id")
  quoteLinkId      String      @map("quote_link_id")
  supplierName     String      @map("supplier_name")
  contactName      String      @map("contact_name")
  contactPhone     String      @map("contact_phone")
  contactWechat    String?     @map("contact_wechat")
  totalRemark      String?     @map("total_remark")
  expectedDelivery DateTime?   @map("expected_delivery")
  includeTax       Boolean     @default(false) @map("include_tax")
  includeShipping  Boolean     @default(false) @map("include_shipping")
  status           QuoteStatus @default(PENDING)
  submittedAt      DateTime    @map("submitted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteLink       QuoteLink   @relation(fields: [quoteLinkId], references: [id], onDelete: Restrict)
  items           QuoteItem[]
  orderAsSelected Order?      @relation("SelectedQuote")

  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String   @map("quote_id")
  orderItemId String   @map("order_item_id")
  price       Decimal  @db.Decimal(18, 4)
  remark      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

// ========== 内贸 CRM 新增模型 ==========

/// 内贸线索（电销用）
model Lead {
  id           String     @id @default(cuid())
  companyName  String     @map("company_name")
  contactName  String     @map("contact_name")
  contactPhone String     @map("contact_phone")
  wechat       String?
  region       String?
  source       String?
  industry     String?
  productNeed  String?    @map("product_need")
  intention    String? // 意向程度：高/中/低
  status       LeadStatus @default(NEW)
  remark       String?
  ownerId      String     @map("owner_id")
  createdById  String     @map("created_by_id")
  customerId   String?    @map("customer_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  owner     User      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy User      @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

/// 内贸客户报价（面向客户，含明细行）
model CustomerQuote {
  id              String              @id @default(cuid())
  customerId      String              @map("customer_id")
  quoteNo         String              @unique @map("quote_no")
  contactName     String              @map("contact_name")
  contactPhone    String              @map("contact_phone")
  projectName     String?             @map("project_name")
  deliveryRegion  String?             @map("delivery_region")
  includeTax      Boolean             @default(true) @map("include_tax")
  includeShipping Boolean             @default(false) @map("include_shipping")
  paymentTerm     String?             @map("payment_term")
  validUntil      DateTime?           @map("valid_until")
  totalAmount     Decimal?            @map("total_amount") @db.Decimal(18, 4)
  status          CustomerQuoteStatus @default(DRAFT)
  wonOrderId      String?             @unique @map("won_order_id")
  remark          String?
  createdById     String              @map("created_by_id")
  approvedById    String?             @map("approved_by_id")
  approvedAt      DateTime?           @map("approved_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("CustomerQuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?               @relation("CustomerQuoteApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  wonOrder   Order?              @relation(fields: [wonOrderId], references: [id], onDelete: SetNull)
  items      CustomerQuoteItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("customer_quotes")
}

/// 内贸客户报价明细行
model CustomerQuoteItem {
  id          String   @id @default(cuid())
  quoteId     String   @map("quote_id")
  sortOrder   Int      @default(0) @map("sort_order")
  productType String   @map("product_type")
  specModel   String   @map("spec_model")
  material    String?
  dimensions  String?
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 4)
  amount      Decimal  @db.Decimal(18, 4)
  theoryWeight Decimal? @map("theory_weight") @db.Decimal(18, 4)
  actualWeight Decimal? @map("actual_weight") @db.Decimal(18, 4)
  remark      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quote CustomerQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("customer_quote_items")
}

/// 内贸每日待办任务
model Task {
  id         String       @id @default(cuid())
  title      String
  type       String       @default("general") // follow_up / quote / moment / general
  customerId String?      @map("customer_id")
  leadId     String?      @map("lead_id")
  dueDate    DateTime?    @map("due_date")
  priority   TaskPriority @default(MEDIUM)
  status     String       @default("todo") // todo / done
  ownerId    String       @map("owner_id")
  notes      String?
  doneAt     DateTime?    @map("done_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([dueDate])
  @@index([status])
  @@index([createdAt])
  @@map("tasks")
}

/// 朋友圈文案库
model Moment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  mediaUrls String[] @map("media_urls")
  category  String? // 产品展示 / 案例分享 / 行业资讯 / 促销活动
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@index([category])
  @@map("moments")
}

/// 跟进记录（文字沟通记录）
model FollowUp {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  content     String   @db.Text
  type        String   @default("call") // call / visit / wechat / note / email
  outcome     String?  // 跟进结果：有意向 / 待考虑 / 拒绝 / 已成交
  nextPlan    String?  @map("next_plan") @db.Text // 下一步计划
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([createdAt])
  @@map("follow_ups")
}

/// 通用文件附件（照片、图纸等）
model FileAttachment {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type") // lead / customer / order
  entityId     String   @map("entity_id")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  category     String?  // photo / drawing / other
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("file_attachments")
}

model OperationLog {
  id         String   @id @default(cuid())
  action     String   @map("action")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  targetName String   @map("target_name")
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  details    String?  @map("details")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("operation_logs")
}

// ========== 外贸 CRM ==========

model ExportTenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  leads          ExportLead[]
  customers      ExportCustomer[]
  contacts       ExportContact[]
  activities     ExportActivity[]
  quotes         ExportQuote[]
  orders         ExportOrder[]
  tasks          ExportTask[]
  sequences      ExportSequence[]
  emailTemplates ExportEmailTemplate[]

  @@map("export_tenants")
}

model ExportSequence {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  prefix    String // CUS, QUO, ORD
  year      Int
  lastSeq   Int      @default(0) @map("last_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant ExportTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix, year])
  @@index([tenantId])
  @@map("export_sequences")
}

model ExportLead {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  companyName           String    @map("company_name")
  website               String?
  country               String?
  city                  String?
  address               String?
  customerType          String?   @map("customer_type")
  sourceChannel         String?   @map("source_channel")
  sourceKeyword         String?   @map("source_keyword")
  email                 String?
  phone                 String?
  whatsapp              String?
  linkedin              String?
  facebook              String?
  tiktok                String?
  mainBusiness          String?   @map("main_business")
  /**
   * 线索：感兴趣产品/需求，自由文本
   */
  productInterest       String?   @map("product_interest")
  priority              String?
  ownerId               String    @map("owner_id")
  status                String    @default("new")
  notes                 String?
  lastContactAt         DateTime? @map("last_contact_at")
  nextFollowUpAt        DateTime? @map("next_follow_up_at")
  /**
   * 累计沟通次数（线索阶段 outbound 自增）
   */
  contactCount          Int       @default(0) @map("contact_count")
  isDuplicate           Boolean   @default(false) @map("is_duplicate")
  duplicateReason       String?   @map("duplicate_reason")
  convertedToCustomerId String?   @map("converted_to_customer_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant     ExportTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  customer   ExportCustomer?  @relation(fields: [convertedToCustomerId], references: [id], onDelete: SetNull)
  activities ExportActivity[]
  tasks      ExportTask[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@index([lastContactAt])
  @@index([nextFollowUpAt])
  @@map("export_leads")
}

model ExportCustomer {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  customerCode       String    @map("customer_code")
  companyName        String    @map("company_name")
  website            String?
  country            String?
  city               String?
  address            String?
  customerType       String?   @map("customer_type")
  industry           String?
  marketPriority     String?   @map("market_priority")
  valueLevel         String?   @map("value_level")
  interestedProducts String[]  @map("interested_products")
  sourceChannel      String?   @map("source_channel")
  ownerId            String    @map("owner_id")
  status             String    @default("to_develop")
  lastFollowUpAt     DateTime? @map("last_follow_up_at")
  nextFollowUpAt     DateTime? @map("next_follow_up_at")
  lastStageChangedAt DateTime? @map("last_stage_changed_at")
  lostReason         String?   @map("lost_reason")
  isWon              Boolean   @default(false) @map("is_won")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant     ExportTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  contacts   ExportContact[]
  activities ExportActivity[]
  quotes     ExportQuote[]
  orders     ExportOrder[]
  tasks      ExportTask[]
  leads      ExportLead[]

  @@unique([tenantId, customerCode])
  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("export_customers")
}

model ExportContact {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  name       String
  title      String?
  email      String?
  phone      String?
  whatsapp   String?
  linkedin   String?
  facebook   String?
  tiktok     String?
  language   String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     ExportTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   ExportCustomer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  activities ExportActivity[]
  quotes     ExportQuote[]
  tasks      ExportTask[]

  @@index([tenantId])
  @@index([customerId])
  @@map("export_contacts")
}

model ExportActivity {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  /**
   * 关联客户（线索阶段为 null）
   */
  customerId           String?   @map("customer_id")
  /**
   * 关联线索（仅线索阶段使用；转客户后置 null 并改填 customerId）
   */
  leadId               String?   @map("lead_id")
  contactId            String?   @map("contact_id")
  type                 String
  /**
   * 沟通方向：outbound 我方发出 / inbound 客户回复
   */
  direction            String    @default("outbound")
  subject              String?
  content              String?
  customerFeedback     String?   @map("customer_feedback")
  customerNameSnapshot String?   @map("customer_name_snapshot")
  contactNameSnapshot  String?   @map("contact_name_snapshot")
  contactEmailSnapshot String?   @map("contact_email_snapshot")
  /**
   * 来源模板（如本次跟进套用了哪个邮件模板）
   */
  templateId           String?   @map("template_id")
  nextFollowUpAt       DateTime? @map("next_follow_up_at")
  ownerId              String    @map("owner_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant   ExportTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer ExportCustomer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     ExportLead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  ExportContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner    User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  template ExportEmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([ownerId])
  @@index([customerId])
  @@index([leadId])
  @@index([direction])
  @@index([createdAt])
  @@map("export_activities")
}

model ExportQuote {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  quoteNo        String    @map("quote_no")
  customerId     String    @map("customer_id")
  contactId      String?   @map("contact_id")
  quoteDate      DateTime  @map("quote_date")
  currency       String?
  incoterm       String?
  validityDate   DateTime? @map("validity_date")
  productSummary String?   @map("product_summary")
  totalAmount    Decimal?  @map("total_amount") @db.Decimal(18, 4)
  status         String    @default("draft")
  isWon          Boolean   @default(false) @map("is_won")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant   ExportTenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer ExportCustomer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact  ExportContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items    ExportQuoteItem[]
  orders   ExportOrder[]

  @@unique([tenantId, quoteNo])
  @@index([tenantId])
  @@index([customerId])
  @@index([createdAt])
  @@map("export_quotes")
}

model ExportQuoteItem {
  id          String   @id @default(cuid())
  quoteId     String   @map("quote_id")
  productType String   @map("product_type")
  spec        String?
  description String?
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 4)
  amount      Decimal  @db.Decimal(18, 4)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quote ExportQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("export_quote_items")
}

model ExportOrder {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  orderNo          String    @map("order_no")
  customerId       String    @map("customer_id")
  quoteId          String?   @map("quote_id")
  orderDate        DateTime  @map("order_date")
  currency         String?
  totalAmount      Decimal?  @map("total_amount") @db.Decimal(18, 4)
  paymentTerm      String?   @map("payment_term")
  paymentStatus    String    @default("unpaid") @map("payment_status")
  productionStatus String    @default("pending") @map("production_status")
  shippingStatus   String    @default("pending") @map("shipping_status")
  eta              DateTime? @map("eta")
  actualShipDate   DateTime? @map("actual_ship_date")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant   ExportTenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer ExportCustomer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote    ExportQuote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items    ExportOrderItem[]

  @@unique([tenantId, orderNo])
  @@index([tenantId])
  @@index([customerId])
  @@index([createdAt])
  @@map("export_orders")
}

model ExportOrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  productType String   @map("product_type")
  spec        String?
  description String?
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 4)
  amount      Decimal  @db.Decimal(18, 4)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order ExportOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("export_order_items")
}

model ExportTask {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  title      String
  customerId String?   @map("customer_id")
  leadId     String?   @map("lead_id")
  contactId  String?   @map("contact_id")
  dueDate    DateTime? @map("due_date")
  priority   String    @default("medium")
  status     String    @default("todo")
  ownerId    String    @map("owner_id")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant   ExportTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer ExportCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead     ExportLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  ExportContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner    User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([ownerId])
  @@index([customerId])
  @@index([leadId])
  @@index([dueDate])
  @@index([createdAt])
  @@map("export_tasks")
}

/**
 * 外贸邮件 / 沟通模板（团队共享）
 */
model ExportEmailTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  /**
   * 模板名称，如「首封开发信 - 工厂自荐 EN」
   */
  name        String
  /**
   * 分类：dev_letter / followup_1 / followup_2 / followup_3 / sample_request / quote_followup / push_close / holiday / other
   */
  category    String
  /**
   * 语言：en / zh
   */
  language    String   @default("en")
  /**
   * 邮件主题，支持变量 {{...}}
   */
  subject     String
  /**
   * 邮件正文，支持变量 {{...}}
   */
  body        String   @db.Text
  /**
   * 是否团队共享（false 表示仅创建人可见）
   */
  isShared    Boolean  @default(true) @map("is_shared")
  /**
   * 内置模板标记（系统种子模板，不可删除）
   */
  isBuiltin   Boolean  @default(false) @map("is_builtin")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     ExportTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  activities ExportActivity[]

  @@index([tenantId])
  @@index([category])
  @@index([language])
  @@map("export_email_templates")
}

/**
 * 外贸数据删除审计（内贸管理员可查看）
 */
model ExportDeletionLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  entityType  String   @map("entity_type")
  recordId    String   @map("record_id")
  summary     String?
  snapshot    Json
  deletedById String   @map("deleted_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  deletedBy User @relation(fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([entityType])
  @@index([createdAt])
  @@map("export_deletion_logs")
}
